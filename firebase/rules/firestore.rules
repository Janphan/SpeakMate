rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default: deny everything unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Questions collection - read only for authenticated users
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin SDK can write
    }
    
    // Conversations collection - users can read/write their own conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Users collection (if used for profile data)
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections under each user
      match /{subCollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}